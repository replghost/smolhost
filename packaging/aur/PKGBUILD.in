# Generated by scripts/build-aur.py; prebuilt upstream binaries, no Cargo build.
pkgname=smolhost-bin
pkgver=@PKGVER@
pkgrel=@REVISION@
pkgdesc='Experimental local Polkadot light-client host (upstream binaries)'
arch=('x86_64')
url='https://github.com/replghost/smolhost'
license=('GPL-3.0-or-later')
depends=('glibc>=@GLIBC_FLOOR@' 'gcc-libs' 'systemd')
makedepends=('python>=3.11')
provides=("smolhost=${pkgver}")
conflicts=('smolhost')
options=('!strip' '!debug')
source=('@ARCHIVE_URL@'
        'package_layout.py')
sha256sums=('@ARCHIVE_SHA256@'
            '@HELPER_SHA256@')

package() {
    # Includes the upstream license and all bundled third-party notices.
    # Users manage their own user units; there are no package lifecycle hooks.
    python "${srcdir}/package_layout.py" --bundle "${srcdir}" --dest "${pkgdir}"
}
